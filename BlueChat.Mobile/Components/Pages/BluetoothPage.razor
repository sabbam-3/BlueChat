@inject IBluetoothConnection bluetoothConnection
@using BlueChat.Core.Abstractions
@using BlueChat.Core.Constants
@using BlueChat.Core.Messaging
<h3>BluetoothPage</h3>

@page "/bluetooth"

<p>Status: <strong>@connectionStatus</strong></p>

<button class="btn btn-primary" @onclick="ScanAsync" disabled="@isScanning">
    @(isScanning ? "Scanning..." : "Scan for Devices")
</button>

@if (devices.Any())
{
    <h4>Discovered Devices:</h4>
    <ul>
        @foreach (var device in devices)
        {
            <li>
                @device
                <button class="btn btn-sm btn-success" @onclick="() => ConnectAsync(device.Split('(')[1].TrimEnd(')'))">Connect</button>
            </li>
        }
    </ul>
}

@if (bluetoothConnection.IsConnected)
{
    <div class="mt-3">
        <button class="btn btn-danger" @onclick="DisconnectAsync">
            Disconnect
        </button>
    </div>

    <div class="mt-3">
        <input @bind="messageToSend" placeholder="Enter message" class="form-control" />
        <button class="btn btn-primary mt-2" @onclick="SendMessageAsync">
            Send
        </button>
    </div>
}

<h4 class="mt-3">Received Data:</h4>
<pre class="bg-light p-2">@recievedData</pre>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@code {
    private List<string> devices = new();
    private string connectionStatus = "Disconnected";
    private string recievedData = string.Empty;
    private string messageToSend = string.Empty;
    private string errorMessage = string.Empty;
    private bool isScanning = false;

    protected override void OnInitialized()
    {
        bluetoothConnection.ConnectionStateChanged += OnConnectionStateChanged;
        bluetoothConnection.DataReceived += OnDataReceived;
        bluetoothConnection.ErrorOccurred += OnErrorOccurred;
        base.OnInitialized();
    }

    private async Task ScanAsync()
    {
        errorMessage = string.Empty;
        isScanning = true;
        devices.Clear();
        StateHasChanged();

        try
        {
            await Task.Run(async () =>
            {
                var discoveredDevices = await bluetoothConnection.DiscoverDevicesAsync();

                devices = discoveredDevices.Select(d => $"{d.DeviceName} ({d.DeviceAddress})").ToList();
            });
        }
        catch(Exception ex)
        {
            errorMessage = $"Failed to scan for devices. {ex.Message}";

        }
        finally
        {
            isScanning = false;
            StateHasChanged();
        }
    }

    private async Task ConnectAsync(string address)
    {
        errorMessage = string.Empty;
        await Task.Run(async () =>
        {
            try
            {
                await bluetoothConnection.ConnectAsync(address, ServiceConstants.ServiceId);
                connectionStatus = "Connected";
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to connect. {ex.Message}";
                connectionStatus = "Disconnected";
            }
            finally
            {
                StateHasChanged();
            }
        });
    }

    private async Task DisconnectAsync()
    {
        errorMessage = string.Empty;
        try
        {
            await Task.Run(() => 
            {
                bluetoothConnection.Disconnect();
            });

            connectionStatus = "Disconnected";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to disconnect. {ex.Message}";
        }
    }

    private async Task SendMessageAsync()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(messageToSend))
        {
            errorMessage = "Message cannot be empty.";
            return;
        }
        try
        {
            await Task.Run(async () =>
            {
                await bluetoothConnection.SendAsync(messageToSend);
            });

            messageToSend = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send message. {ex.Message}";
        }
    }

    private async void OnConnectionStateChanged(object sender, ConnectionStateEventArgs e)
    {
        // InvokeAsync because event comes from background thread
        await InvokeAsync(() =>
        {
            connectionStatus = e.State switch
            {
                ConnectionState.Connecting => "⏳ Connecting...",
                ConnectionState.Connected => "✅ Connected",
                ConnectionState.Disconnecting => "⏳ Disconnecting...",
                ConnectionState.Disconnected => "❌ Disconnected",
                _ => "Unknown"
            };
            StateHasChanged();
        });
    }

    private async void OnDataReceived(object sender, DataReceivedEventArgs e)
    {
        await InvokeAsync(() =>
        {
            recievedData += $"[{e.Timestamp:HH:mm:ss}] {e.Text}\n";
            StateHasChanged();
        });
    }

    private async void OnErrorOccurred(object sender, BluetoothErrorEventArgs e)
    {
        await InvokeAsync(() =>
        {
            errorMessage = e.Message;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        // Always unsubscribe!
        bluetoothConnection.ConnectionStateChanged -= OnConnectionStateChanged;
        bluetoothConnection.DataReceived -= OnDataReceived;
        bluetoothConnection.ErrorOccurred -= OnErrorOccurred;
    }
}
